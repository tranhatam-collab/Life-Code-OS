{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Life Code OS — Work order admission contract 2026-10-29",
  "description": "Required contract before DEV dispatch; this schema does not grant permission or mark gates complete.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_order_id",
    "source_task_ids",
    "title",
    "status",
    "scope",
    "exclusions",
    "owner",
    "reviewer",
    "authority",
    "baseline",
    "source_refs",
    "dependencies",
    "version_bundle",
    "deliverables",
    "acceptance",
    "tests",
    "evidence",
    "rollback",
    "estimate",
    "release"
  ],
  "properties": {
    "work_order_id": {
      "type": "string",
      "pattern": "^(INT29-[0-9]{3}|[A-Z0-9-]+)$"
    },
    "source_task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "PROPOSED_NOT_DISPATCHED",
        "READY_FOR_SCOPED_DEV",
        "IN_PROGRESS",
        "BLOCKED",
        "VERIFIED_LOCAL",
        "VERIFIED_STAGING",
        "CLOSED_FOR_SCOPE"
      ]
    },
    "scope": {
      "type": "object",
      "required": [
        "capabilities",
        "cohort",
        "environment",
        "purpose",
        "data_classes"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cohort": {
          "type": "string"
        },
        "environment": {
          "enum": [
            "DOCUMENTATION",
            "SYNTHETIC_LOCAL",
            "LOCAL_CANDIDATE",
            "STAGING",
            "PRODUCTION"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "data_classes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "$ref": "#/$defs/personRole"
    },
    "reviewer": {
      "$ref": "#/$defs/personRole"
    },
    "authority": {
      "type": "object",
      "required": [
        "work_scope_authorized",
        "decision_receipts",
        "provider_access_authorized",
        "production_action_authorized"
      ],
      "properties": {
        "work_scope_authorized": {
          "type": "boolean"
        },
        "decision_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provider_access_authorized": {
          "type": "boolean"
        },
        "production_action_authorized": {
          "type": "boolean"
        }
      }
    },
    "baseline": {
      "type": "object",
      "required": [
        "repo_root",
        "remote",
        "branch",
        "full_head_sha",
        "worktree_status_receipt",
        "candidate_artifact_sha256",
        "source_bundle_receipt",
        "target_environment"
      ],
      "properties": {
        "repo_root": {
          "type": "string"
        },
        "remote": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "full_head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "worktree_status_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_bundle_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_environment": {
          "type": "string"
        }
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "package_id",
          "path",
          "sha256",
          "source_record_id"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source_record_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "required": [
        "task_dependencies",
        "decision_dependencies",
        "gate_dependencies",
        "parent_rollup_ids",
        "raw_source_dependencies",
        "scoped_completion_rule"
      ],
      "properties": {
        "task_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "decision_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q[0-9]+$"
          },
          "uniqueItems": true
        },
        "gate_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(G[0-9]{2}|RG[0-9]+)$"
          },
          "uniqueItems": true
        },
        "parent_rollup_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw_source_dependencies": {},
        "scoped_completion_rule": {
          "type": "string"
        }
      }
    },
    "version_bundle": {
      "type": "object",
      "required": [
        "profile_version",
        "hypothesis_version",
        "schema_version",
        "method_release",
        "source_edition_digest",
        "rights_receipt",
        "formula_config_digest",
        "consent_revision",
        "purpose",
        "locale_release",
        "claim_policy",
        "model_prompt_release"
      ],
      "properties": {
        "profile_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "hypothesis_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "schema_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "method_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_edition_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "formula_config_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "consent_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "locale_release": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_prompt_release": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "artifact_kind",
          "review_method"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "artifact_kind": {
            "type": "string"
          },
          "review_method": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "expected_result",
          "source_or_decision_ref"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          },
          "source_or_decision_ref": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "tests": {
      "type": "object",
      "required": [
        "positive",
        "negative",
        "boundary",
        "privacy_and_auth",
        "failure_and_recovery",
        "performance_class",
        "fixture_provenance",
        "skips_with_reasons"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "boundary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "privacy_and_auth": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failure_and_recovery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performance_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture_provenance": {
          "type": "string"
        },
        "skips_with_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "directory",
        "receipt_fields",
        "independent_review_receipt",
        "status"
      ],
      "properties": {
        "directory": {
          "type": "string"
        },
        "receipt_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "independent_review_receipt": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "NOT_CHECKED",
            "VERIFIED_CURRENT",
            "VERIFIED_LOCAL_ONLY",
            "VERIFIED_STAGING_ONLY",
            "REPORTED_UNVERIFIED",
            "CONTRADICTED",
            "BLOCKED"
          ]
        }
      }
    },
    "rollback": {
      "type": "object",
      "required": [
        "trigger",
        "operator_role",
        "procedure",
        "data_reconciliation",
        "restore_deletion_barrier",
        "verification"
      ],
      "properties": {
        "trigger": {
          "type": "string"
        },
        "operator_role": {
          "type": "string"
        },
        "procedure": {
          "type": "string"
        },
        "data_reconciliation": {
          "type": "string"
        },
        "restore_deletion_barrier": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        }
      }
    },
    "estimate": {
      "type": "object",
      "required": [
        "low_person_days",
        "high_person_days",
        "status",
        "rollup_policy",
        "overlaps_source_task_ids",
        "currency",
        "monetary_value"
      ],
      "properties": {
        "low_person_days": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "high_person_days": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "UNKNOWN",
            "PROPOSAL_NOT_APPROVED",
            "APPROVED_FOR_SCOPE"
          ]
        },
        "rollup_policy": {
          "type": "string"
        },
        "overlaps_source_task_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "currency": {
          "type": [
            "string",
            "null"
          ]
        },
        "monetary_value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "release": {
      "type": "object",
      "required": [
        "production_permission",
        "approver_names",
        "gate_receipts",
        "expires_or_revisit"
      ],
      "properties": {
        "production_permission": {
          "const": false
        },
        "approver_names": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "gate_receipts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expires_or_revisit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "$defs": {
    "personRole": {
      "type": "object",
      "required": [
        "role",
        "name",
        "accepted_at"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "x-validation-rules": [
    "Task/decision/gate IDs must resolve against canonical catalogs; parent_rollup_ids are not automatically predecessor edges.",
    "No cyclic task DAG or decision DAG. Gate dependencies are predicates, not task nodes.",
    "Reviewer must be independent of implementation author; null owner/reviewer names cannot satisfy READY_FOR_SCOPED_DEV.",
    "Required decisions/source rights/schema/cohort must be approved for the specific capability and candidate before gated DEV dispatch.",
    "Unknown estimate is null; never coerce to zero; reconcile parent/child overlap before any approved rollup.",
    "Evidence must identify exact source/candidate/artifact/environment; a local or historical report cannot close staging/production gates.",
    "This preparation schema always has production_permission=false. Production authorization requires separate immutable release receipt."
  ]
}
