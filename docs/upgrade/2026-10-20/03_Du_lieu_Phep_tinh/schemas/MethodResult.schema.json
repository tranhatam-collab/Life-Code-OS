{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/MethodResult.json",
  "title": "MethodResult",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0-proposed"
    },
    "result_id": {
      "type": "string",
      "format": "uuid"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "profile_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "method_id": {
      "type": "string"
    },
    "method_release_id": {
      "type": "string"
    },
    "configuration_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_field_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^F[0-9]{3}$"
      }
    },
    "calculation_version": {
      "type": "string",
      "minLength": 1
    },
    "calculation": {
      "type": "object",
      "minProperties": 1,
      "description": "Method-specific schema validated separately; not arbitrary personal claims."
    },
    "output_kind": {
      "enum": [
        "deterministic_calculation",
        "observation_summary",
        "symbolic_map",
        "approved_model"
      ]
    },
    "metric": {
      "anyOf": [
        {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://schemas.lifecode.iai.one/proposed/Metric.json",
          "title": "Metric",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric_id": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            },
            "method_id": {
              "type": "string",
              "minLength": 1
            },
            "window": {
              "type": [
                "string",
                "null"
              ]
            },
            "higher_means": {
              "enum": [
                "more",
                "less",
                "not_ordered"
              ]
            },
            "scale_min": {"type": "number"},
            "scale_max": {"type": "number"},
            "direction": {
              "enum": ["higher_is_more", "higher_is_less", "not_ordered"]
            },
            "formula_version": {"type": "string", "minLength": 1},
            "observation_window": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "properties": {
                "start": {"type": "string", "format": "date-time"},
                "end": {"type": "string", "format": "date-time"},
                "timezone_id": {"type": "string", "minLength": 1}
              },
              "required": ["start", "end", "timezone_id"]
            },
            "decimal_places": {"type": "integer", "minimum": 0, "maximum": 12},
            "rounding_mode": {
              "enum": ["half_even", "half_up", "down", "not_applicable"]
            },
            "missing_reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "metric_id",
            "value",
            "unit",
            "meaning",
            "method_id",
            "higher_means",
            "scale_min",
            "scale_max",
            "direction",
            "formula_version",
            "observation_window",
            "decimal_places",
            "rounding_mode",
            "missing_reason"
          ],
          "allOf": [
            {
              "if": {"properties": {"value": {"type": "null"}}},
              "then": {"properties": {"missing_reason": {"type": "string", "minLength": 1}}},
              "else": {"properties": {"missing_reason": {"type": "null"}}}
            },
            {
              "if": {"properties": {"unit": {"const": "percent"}}, "required": ["unit"]},
              "then": {"properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "scale_min": {"const": 0}, "scale_max": {"const": 100}}}
            },
            {
              "if": {"properties": {"unit": {"const": "ratio"}}, "required": ["unit"]},
              "then": {"properties": {"value": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "scale_min": {"const": 0}, "scale_max": {"const": 1}}}
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["extraction", "data_quality", "model_calibration"]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": ["kind", "value", "meaning", "evidence_ids"],
      "description": "If present needs kind, meaning and evidence; forbidden by default for symbolic methods."
    },
    "probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "model_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "model_release_id": {"type": "string", "minLength": 1},
        "target_event": {"type": "string", "minLength": 1},
        "horizon": {"type": "string", "minLength": 1},
        "population": {"type": "string", "minLength": 1},
        "evaluation_receipt_id": {"type": "string", "minLength": 1},
        "applicability_checked": {"const": true}
      },
      "required": ["model_release_id", "target_event", "horizon", "population", "evaluation_receipt_id", "applicability_checked"]
    },
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.lifecode.iai.one/proposed/Claim.json",
        "title": "Claim",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "format": "uuid"
          },
          "subject_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "enum": [
              "fact",
              "self_report",
              "observation",
              "symbolic_interpretation",
              "derived_metric",
              "model_probability"
            ]
          },
          "text_vi": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "result_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "probability": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          },
          "model_release_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "model_evidence": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "properties": {
              "target_event": {"type": "string", "minLength": 1},
              "horizon": {"type": "string", "minLength": 1},
              "population": {"type": "string", "minLength": 1},
              "evaluation_receipt_id": {"type": "string", "minLength": 1},
              "applicability_checked": {"const": true}
            },
            "required": ["target_event", "horizon", "population", "evaluation_receipt_id", "applicability_checked"]
          },
          "limitations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "review_state": {
            "enum": [
              "draft",
              "needs_review",
              "approved",
              "rejected",
              "withdrawn"
            ]
          }
        },
        "required": [
          "claim_id",
          "subject_id",
          "type",
          "text_vi",
          "source_ids",
          "scope",
          "probability",
          "model_release_id",
          "model_evidence",
          "limitations",
          "review_state"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "model_probability"
                }
              }
            },
            "then": {
              "properties": {
                "probability": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "model_release_id": {
                  "type": "string",
                  "minLength": 1
                },
                "model_evidence": {
                  "type": "object"
                }
              },
              "required": [
                "probability",
                "model_release_id",
                "model_evidence"
              ]
            },
            "else": {
              "properties": {
                "probability": {
                  "type": "null"
                },
                "model_release_id": {
                  "type": "null"
                },
                "model_evidence": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "missing_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "unresolved_rules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "complete",
        "partial",
        "blocked",
        "failed",
        "withdrawn"
      ]
    }
  },
  "required": [
    "schema_version",
    "result_id",
    "run_id",
    "subject_id",
    "profile_version_id",
    "method_id",
    "method_release_id",
    "configuration_digest",
    "input_digest",
    "input_field_ids",
    "calculation_version",
    "calculation",
    "output_kind",
    "metric",
    "confidence",
    "probability",
    "model_evidence",
    "claims",
    "missing_inputs",
    "unresolved_rules",
    "limitations",
    "created_at",
    "state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "output_kind": {
            "enum": [
              "deterministic_calculation",
              "symbolic_map",
              "observation_summary"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "probability": {
            "type": "null"
          },
          "model_evidence": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {"output_kind": {"const": "approved_model"}},
        "required": ["output_kind"]
      },
      "then": {
        "properties": {
          "probability": {"type": "number", "minimum": 0, "maximum": 1},
          "model_evidence": {"type": "object"}
        }
      }
    },
    {
      "if": {
        "properties": {"output_kind": {"const": "symbolic_map"}},
        "required": ["output_kind"]
      },
      "then": {
        "properties": {"confidence": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "complete"}},
        "required": ["state"]
      },
      "then": {
        "properties": {
          "missing_inputs": {"type": "array", "maxItems": 0},
          "unresolved_rules": {"type": "array", "maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"state": {"const": "blocked"}},
        "required": ["state"]
      },
      "then": {
        "anyOf": [
          {"properties": {"missing_inputs": {"type": "array", "minItems": 1}}},
          {"properties": {"unresolved_rules": {"type": "array", "minItems": 1}}},
          {"properties": {"limitations": {"type": "array", "minItems": 1}}}
        ]
      }
    }
  ]
}
