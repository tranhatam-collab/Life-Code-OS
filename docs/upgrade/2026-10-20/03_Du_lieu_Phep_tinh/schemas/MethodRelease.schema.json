{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/MethodRelease.json",
  "title": "MethodRelease",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0-proposed"
    },
    "method_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "pattern": "^K(0[1-9]|1[0-9]|20)$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "computation_kind": {
      "enum": [
        "deterministic_normalization",
        "deterministic_calculation",
        "deterministic_table_lookup",
        "deterministic_metric",
        "deterministic_temporal_intervals",
        "symbolic_calendar_calculation",
        "guided_self_reflection",
        "multi_subject_guided_reflection",
        "instrument_scoring_unselected",
        "image_observation_description",
        "unselected_variant"
      ]
    },
    "evidence_class": {
      "enum": [
        "research_only",
        "specification_only",
        "specification_incomplete",
        "reference_tested_not_outcome_validated",
        "calculation_reproduced_symbolic_authority_unverified",
        "validated_instrument",
        "approved_model"
      ]
    },
    "release_state": {
      "enum": [
        "blocked",
        "research_only",
        "candidate",
        "permitted",
        "suspended",
        "retired"
      ]
    },
    "status": {
      "enum": [
        "researching",
        "specified",
        "calculation_verified",
        "content_reviewed",
        "permitted_for_product",
        "deprecated",
        "retired"
      ]
    },
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "edition_locations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "rights_status": {
      "enum": [
        "pending",
        "permitted",
        "restricted",
        "expired"
      ]
    },
    "input_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "output_schema_ref": {
      "type": "string",
      "minLength": 1
    },
    "rule_spec_ref": {
      "type": "string",
      "minLength": 1
    },
    "configuration": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "golden_cases_ref": {
      "type": "string",
      "minLength": 1
    },
    "test_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_claim_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fact",
          "self_report",
          "observation",
          "symbolic_interpretation",
          "derived_metric",
          "model_probability"
        ]
      }
    },
    "allowed_product_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "allowed_country_packs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_rights_receipt_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "release_artifact_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "effective_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "method_id",
    "release_id",
    "family_id",
    "version",
    "computation_kind",
    "evidence_class",
    "release_state",
    "status",
    "source_ids",
    "edition_locations",
    "rights_status",
    "input_schema_ref",
    "output_schema_ref",
    "rule_spec_ref",
    "configuration",
    "limitations",
    "golden_cases_ref",
    "test_receipt_ref",
    "allowed_claim_types",
    "allowed_product_ids",
    "allowed_country_packs",
    "approved_by",
    "approved_at",
    "source_rights_receipt_ids",
    "release_artifact_digest",
    "effective_at",
    "expires_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "permitted_for_product"
          }
        }
      },
      "then": {
        "properties": {
          "rights_status": {
            "const": "permitted"
          },
          "release_state": {
            "const": "permitted"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1
          },
          "test_receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "edition_locations": {
            "type": "array",
            "minItems": 1
          },
          "source_rights_receipt_ids": {
            "type": "array",
            "minItems": 1
          },
          "allowed_product_ids": {
            "type": "array",
            "minItems": 1
          },
          "allowed_country_packs": {
            "type": "array",
            "minItems": 1
          },
          "release_artifact_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "effective_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "release_state": {"const": "permitted"}
        },
        "required": ["release_state"]
      },
      "then": {
        "properties": {
          "status": {"const": "permitted_for_product"}
        }
      }
    }
  ]
}
