      "inputs": ["F002"],
      "output_kind": "deterministic_calculation",
      "null_policy": "unsupported script or missing approved transliteration returns unsupported",
      "range_policy": "sum is a non-negative integer; no personality range is defined",
      "decimal_policy": "integer_only",
      "timezone_policy": null,
      "source_ids": [],
      "demo_cases": [
        {"case_id": "NAME-CYCLE-REFERENCE-01", "input": "Trần Hà Tâm", "expected_sum": 33, "expected_root": 6, "claim": "calculation_only"},
        {"case_id": "NAME-CYCLE-UNSUPPORTED-SCRIPT", "input": "陳", "expected_status": "unsupported"}
      ],
      "runtime_invariants": ["original and normalized strings remain distinct", "transliteration adapter is explicit", "no personality or destiny claim"],
      "release_state": "blocked"
    },
