    {
      "formula_id": "FC-TAIL80-001",
      "method_ids": ["M06"],
      "name": "Four-digit modulo 80",
      "specification_state": "calculation_specified_symbolic_table_unverified",
      "expression": "N = int(four_ascii_digits); quotient = floor(N / 80); remainder = N mod 80; lookup = null when remainder=0 and zero_policy=unmapped, otherwise remainder or 80",
      "inputs": [],
      "missing_registry_inputs": ["raw_identifier", "numbering_context", "normalized_identifier", "tail4_suffix"],
      "output_kind": "deterministic_calculation_plus_optional_symbolic_lookup",
      "null_policy": "remainder 0 with unmapped policy gives null lookup and null label",
      "range_policy": "N 0000..9999; quotient 0..124; remainder 0..79; lookup null or 1..80",
      "decimal_policy": "integer_only_no_fraction_truncation",
      "timezone_policy": null,
      "source_ids": ["USER_TABLE80", "USER_TABLE80_CONVERSATION"],
      "demo_cases": [
        {"case_id": "TAIL80-6231", "suffix": "6231", "zero_policy": "unmapped", "quotient": 77, "remainder": 71, "lookup_code": 71},
        {"case_id": "TAIL80-1986", "suffix": "1986", "zero_policy": "unmapped", "quotient": 24, "remainder": 66, "lookup_code": 66},
        {"case_id": "TAIL80-3468", "suffix": "3468", "zero_policy": "unmapped", "quotient": 43, "remainder": 28, "lookup_code": 28},
        {"case_id": "TAIL80-0080-UNMAPPED", "suffix": "0080", "zero_policy": "unmapped", "quotient": 1, "remainder": 0, "lookup_code": null},
        {"case_id": "TAIL80-0080-AS80", "suffix": "0080", "zero_policy": "as80", "quotient": 1, "remainder": 0, "lookup_code": 80},
        {"case_id": "TAIL80-NON-ASCII-REJECT", "suffix": "１２３４", "expected_status": "blocked"}
      ],
      "runtime_invariants": ["N = 80 * quotient + remainder", "suffix is exactly four ASCII digits", "symbolic label is separate from arithmetic", "probability is null", "is_personalized is false"],
      "release_state": "blocked"
    },
