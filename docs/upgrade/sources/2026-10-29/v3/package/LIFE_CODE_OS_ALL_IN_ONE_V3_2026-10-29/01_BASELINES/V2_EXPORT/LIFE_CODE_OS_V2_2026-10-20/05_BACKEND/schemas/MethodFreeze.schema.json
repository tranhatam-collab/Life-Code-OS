{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v2:MethodFreeze",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "expected_version": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "enum": [
        "new_runs",
        "publication",
        "all_processing"
      ]
    }
  },
  "required": [
    "expected_version",
    "reason",
    "scope"
  ]
}
