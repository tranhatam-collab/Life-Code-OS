@@ -0,0 +1,15 @@
+flowchart TD
+ Web[Web và mobile] --> G[Gateway: xác thực và quyền]
+ G --> P[Phiên bản hồ sơ và giả thuyết]
+ P --> O[Orchestrator / DAG]
+ O --> M[Method core có phiên bản]
+ O --> J[Quan sát và nhật ký]
+ M --> C[Claim registry]
+ J --> C
+ C --> S[HNH synthesis]
+ S --> W[Writer và Reviewer]
+ W --> R[Report snapshot]
+ R --> A[Web / PDF / Word]
+ G --> DB[(PostgreSQL)]
+ O --> Q[Outbox và Queue]
+ R --> FS[(Private R2)]
diff --git a/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/02_analysis_sequence.mmd b/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/02_analysis_sequence.mmd
new file mode 100644
index 0000000000000000000000000000000000000000..7576815e45e939118f9a21afb191cc782516c411
--- /dev/null
+++ b/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/02_analysis_sequence.mmd
@@ -0,0 +1,17 @@
+sequenceDiagram
+ participant U as Người dùng
+ participant API as API có quyền
+ participant DB as PostgreSQL
+ participant Q as Queue
+ participant W as Worker
+ U->>API: Tạo run và idempotency key
+ API->>DB: Transaction: run + receipt + outbox
+ DB-->>API: Run ID
+ API-->>U: 202 và trạng thái
+ DB->>Q: Publisher gửi lại được
+ Q->>W: Job có operation ID
+ W->>DB: Kiểm lại quyền và deletion barrier
+ W->>W: DAG và công thức đã phát hành
+ W->>DB: Kết quả có provenance
+ W->>DB: Kiểm lại quyền trước publish
+ DB-->>U: Báo cáo khi đã được duyệt
diff --git a/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/03_run_state.mmd b/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/03_run_state.mmd
new file mode 100644
index 0000000000000000000000000000000000000000..adc311096d7e02fc4d2accf861225c400dc043be
--- /dev/null
+++ b/docs/upgrades/2026-10-20-v2/05_BACKEND/diagrams/03_run_state.mmd
@@ -0,0 +1,15 @@
+stateDiagram-v2
+ [*] --> queued
+ queued --> running
+ queued --> cancelled
+ running --> review_required
+ running --> blocked
+ running --> failed
+ running --> cancel_requested
+ cancel_requested --> cancelled
+ review_required --> approved
+ review_required --> blocked
+ approved --> published
+ approved --> stale
+ published --> withdrawn
+ withdrawn --> [*]
