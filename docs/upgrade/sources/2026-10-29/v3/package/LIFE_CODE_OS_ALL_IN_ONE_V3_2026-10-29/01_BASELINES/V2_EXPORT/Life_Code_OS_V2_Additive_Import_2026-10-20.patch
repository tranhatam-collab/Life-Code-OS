+export function birthNumbers(input){const {birth_date,reduction_policy='single_digit',variant='all_digits'}=input;const d=parseDate(birth_date);enumValue(variant,['all_digits','reduced_components'],'variant');const raw=digitSum(birth_date.replace(/-/g,''));const components={day:reduction(d.day,reduction_policy),month:reduction(d.month,reduction_policy),year:reduction(digitSum(String(d.year)),reduction_policy)};const base=variant==='all_digits'?raw:components.day.value+components.month.value+components.year.value;return result('LCF-07','2.0',input,{variant,reduction_policy},{raw_digit_sum:raw,components,calculation_sum:base,reduction:reduction(base,reduction_policy)},[],['Các số trung gian thay đổi theo trường phái; không gộp ngầm.']);}
+export function personalCycle(input){const {birth_date,year,month=null,boundary='calendar',as_of=null}=input;const b=parseDate(birth_date);integer(year,1600,2500,'year');enumValue(boundary,['calendar','birthday'],'boundary');let useYear=year;if(boundary==='birthday'){ensure(as_of!==null,'AS_OF_REQUIRED','Chu kỳ theo sinh nhật cần ngày đối chiếu.');parseDate(as_of);ensure(as_of.startsWith(String(year)+'-'),'AS_OF_MISMATCH','Ngày đối chiếu phải thuộc năm được chọn.');if(as_of<anniversary(birth_date,year,'feb28'))useYear--;}
+ const sum=root(b.day)+root(b.month)+root(digitSum(String(useYear)));const py=root(sum);if(month!==null)integer(month,1,12,'month');return result('LCF-08','2.0',input,{boundary,reduction:'single_digit',birthday_leap_policy:'feb28'},{effective_year:useYear,personal_year:py,personal_month:month===null?null:root(py+month),sum},[],['Chu kỳ biểu tượng không dự báo sự kiện.']);}
+function utcMillis(y,m,d,hh=0,mm=0,ss=0){const a=new Date(0);a.setUTCFullYear(y,m-1,d);a.setUTCHours(hh,mm,ss,0);return a.getTime();}
+function localParts(t,tz){const f=new Intl.DateTimeFormat('en-CA',{timeZone:tz,year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit',hourCycle:'h23'});const x=Object.fromEntries(f.formatToParts(new Date(t)).filter(x=>x.type!=='literal').map(x=>[x.type,Number(x.value)]));return x;}
+export function localTimeCandidates(input){const {date,time,time_zone}=input;const d=parseDate(date);ensure(d.year>=1900&&d.year<=2100,'TIME_RANGE','Demo múi giờ giới hạn 1900–2100.');ensure(typeof time==='string'&&/^\d{2}:\d{2}$/.test(time),'INVALID_TIME','Giờ phải là HH:MM.');const [hh,mm]=time.split(':').map(Number);integer(hh,0,23,'giờ');integer(mm,0,59,'phút');ensure(typeof time_zone==='string'&&time_zone.length<=80,'TIMEZONE_REQUIRED','Cần tên múi giờ IANA rõ ràng.');try{new Intl.DateTimeFormat('en',{timeZone:time_zone}).format(new Date(0));}catch{ensure(false,'INVALID_TIMEZONE','Múi giờ chưa được hỗ trợ.');}
+ const naive=utcMillis(d.year,d.month,d.day,hh,mm);const offsets=new Set();
+ for(let h=-48;h<=48;h+=3){const t=naive+h*3600000;const x=localParts(t,time_zone);offsets.add(utcMillis(x.year,x.month,x.day,x.hour,x.minute,x.second)-t);}
+ const candidates=[...offsets].map(off=>({t:naive-off,off})).filter(({t})=>{const x=localParts(t,time_zone);return x.year===d.year&&x.month===d.month&&x.day===d.day&&x.hour===hh&&x.minute===mm&&x.second===0;}).sort((a,b)=>a.t-b.t).map(({t,off})=>({utc:new Date(t).toISOString(),offset_seconds:off/1000}));
+ return result('LCF-09','2.0',input,{provider:'Intl/ICU',node:process.versions.node,icu:process.versions.icu,tzdb:process.versions.tz??'runtime_not_exposed',policy:'enumerate_candidates_no_silent_pick'},{candidates,state:candidates.length===0?'nonexistent':candidates.length===1?'exact':'ambiguous'},[],candidates.length===1?[]:[candidates.length?'DST_FOLD_REQUIRES_CHOICE':'DST_GAP_REQUIRES_CORRECTION']);}
+export function compareHypotheses(input){ensure(Array.isArray(input.hypotheses)&&input.hypotheses.length>=2&&input.hypotheses.length<=5,'INVALID_HYPOTHESES','Cần 2–5 phương án dữ liệu.');const rows=input.hypotheses.map(h=>({id:h.id,birth_date:h.birth_date,result:birthNumbers({birth_date:h.birth_date}).calculation}));ensure(new Set(rows.map(r=>r.id)).size===rows.length,'DUPLICATE_HYPOTHESIS','Mã phương án phải duy nhất.');return result('LCF-10','2.0',input,{policy:'no_preferred_hypothesis'},{alternatives:rows,selected:null},[],['Không lấy trung bình hai ngày sinh; không chọn phương án theo lời luận nghe hợp.']);}
