+export function hexagramTransform(input){const {lines_bottom_up,changing_lines=[]}=input;ensure(Array.isArray(lines_bottom_up)&&lines_bottom_up.length===6&&lines_bottom_up.every(v=>v===0||v===1),'INVALID_LINES','Cần sáu giá trị 0/1 theo thứ tự từ dưới lên.');ensure(Array.isArray(changing_lines)&&new Set(changing_lines).size===changing_lines.length,'INVALID_CHANGING_LINES','Danh sách hào động không được trùng.');for(const n of changing_lines)integer(n,1,6,'hào');const altered=lines_bottom_up.map((v,i)=>changing_lines.includes(i+1)?1-v:v);const index=a=>a.reduce((s,v,i)=>s+(v<<i),0);return result('LCF-16','2.0',input,{orientation:'bottom_up',yin:0,yang:1,numbering:'binary_not_king_wen'},{original_lines:lines_bottom_up,changed_lines:altered,original_binary_index:index(lines_bottom_up),changed_binary_index:index(altered)},[],['Chỉ biến đổi cấu trúc sáu hào; chưa gán tên quẻ, lời quẻ hoặc dự đoán.']);}
+export function blockedMethod(input){const prohibited=['face.personality','medical_risk_from_palm'].includes(input.method_id);return {method_id:input.method_id??'unspecified',status:prohibited?'POLICY_BLOCKED':'METHOD_NOT_RELEASED',claim_type:'symbolic_interpretation',calculation:null,score:null,confidence:null,probability:null,missing_requirements:prohibited?[]:['approved_source_edition','licensed_rule_spec','independent_golden_cases','human_release_approval'],limitations:[prohibited?'Loại suy luận cá nhân này nằm ngoài phạm vi sản phẩm; không chỉ là thiếu dữ liệu.':'Danh mục nghiên cứu được giữ; không sinh kết quả thay thế bằng suy đoán.']};}
