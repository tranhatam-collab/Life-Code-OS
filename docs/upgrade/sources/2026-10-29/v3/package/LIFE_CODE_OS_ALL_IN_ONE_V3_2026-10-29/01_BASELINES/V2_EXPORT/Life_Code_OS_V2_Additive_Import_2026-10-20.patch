+ALTER TABLE lc.audit_event FORCE ROW LEVEL SECURITY;
+REVOKE ALL ON lc.audit_event FROM PUBLIC;
+
+-- Track all stores and backup tombstone
+CREATE TABLE lc.deletion_job (
