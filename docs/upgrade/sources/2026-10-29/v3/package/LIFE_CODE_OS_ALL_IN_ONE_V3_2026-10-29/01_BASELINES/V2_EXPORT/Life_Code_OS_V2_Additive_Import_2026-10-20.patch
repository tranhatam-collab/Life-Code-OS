--- /dev/null
+++ b/docs/upgrades/2026-10-20-v2/01_BASELINE/2026-10-11/10_Ma_tham_chieu_Kiem_thu/tests/reference.test.mjs
@@ -0,0 +1,71 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {digitalRoot,digitSum,normalizeVietnameseName,nameCycle,tail80,pairMap,analyzePairs} from '../src/numbers.mjs';
+import {coverage,allowed,eligible,assertClaim,goalProgress,ReceiptLedger} from '../src/policies.mjs';
+const table=JSON.parse(fs.readFileSync(new URL('../data/tail80_table.json',import.meta.url),'utf8'));
+const T=(n,f)=>test(n,f);
+T('tail80: toàn miền 10.000 suffix, thương/số dư/ánh xạ',()=>{
+ let counts=Array(81).fill(0);
+ for(let i=0;i<10000;i++){
+  const s=String(i).padStart(4,'0'),r=tail80(s,{zeroPolicy:'as80',table});
+  assert.equal(r.remainder,i-80*Math.floor(i/80));assert.equal(r.suffix,s);
+  assert.ok(r.lookup_code>=1&&r.lookup_code<=80);counts[r.lookup_code]++;
+ }
+ assert.ok(counts.slice(1).every(n=>n===125));
+});
+T('tail80 bảng đúng80mục duy nhất',()=>{assert.equal(table.records.length,80);assert.equal(new Set(table.records.map(r=>r.code)).size,80);});
+T('tail80 phân bố nhãn giữ nguồn',()=>{const c={};table.records.forEach(r=>c[r.source_label]=(c[r.source_label]??0)+1);assert.deepEqual(c,{'Cát':23,'Bình':16,'Đại cát':15,'Hung':23,'Đại hung':3});});
+for(const [s,r] of [['0000',0],['0001',1],['0079',79],['0080',0],['0081',1],['0160',0],['6789',69],['6869',69],['6231',71],['1986',66],['3468',28],['9999',79]]) T('tail80 '+s,()=>assert.equal(tail80(s).remainder,r));
+T('tail80zero mặc định unresolved',()=>assert.equal(tail80('0080').lookup_code,null));
+T('tail80zero opt-in80',()=>assert.equal(tail80('0080',{zeroPolicy:'as80'}).lookup_code,80));
+for(const bad of [1234,'123','12345','12a4',' 1234','12 34','12.3','-123','１２３４',null,undefined,''])T('tail80 invalid '+String(bad),()=>assert.throws(()=>tail80(bad)));
+T('tail80zero policy invalid',()=>assert.throws(()=>tail80('1234',{zeroPolicy:'plus1'})));
+T('tail80 prefix invariant dùng BigInt',()=>{for(const p of ['84','123456789012345678901234'])assert.equal(Number(BigInt(p+'6789')%80n),69);});
+T('digitalRoot 0',()=>assert.equal(digitalRoot(0),0));
+T('digitalRoot36',()=>assert.equal(digitalRoot(36),9));
+T('digitalRoot38',()=>assert.equal(digitalRoot(38),2));
+T('digitalRoot negative rejected',()=>assert.throws(()=>digitalRoot(-1)));
+T('digitalRoot unsafe rejected',()=>assert.throws(()=>digitalRoot(Number.MAX_SAFE_INTEGER+1)));
+T('digitSum exactdigits',()=>assert.equal(digitSum('24091983'),36));
