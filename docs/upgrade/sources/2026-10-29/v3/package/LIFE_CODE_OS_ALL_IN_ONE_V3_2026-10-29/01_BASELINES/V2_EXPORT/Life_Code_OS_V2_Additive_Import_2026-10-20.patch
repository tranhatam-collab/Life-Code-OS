+export function inputCoverage(input){const req=REQUIREMENTS[input.product_release];ensure(Boolean(req),'UNKNOWN_PRODUCT_RELEASE','Không có yêu cầu đầu vào cho bản sản phẩm này.');ensure(Array.isArray(input.valid_field_ids),'INVALID_VALIDATION_SET','Cần danh sách trường đã qua kiểm tra.');ensure(!('weights' in input)&&!('scores' in input),'CLIENT_SCORES_FORBIDDEN','Không nhận trọng số hoặc điểm do client quyết định.');const ids=new Set(input.valid_field_ids);const total=req.reduce((s,r)=>s+r.weight,0),done=req.filter(r=>ids.has(r.id)).reduce((s,r)=>s+r.weight,0);return result('LCF-11','2.0',input,{requirements_source:'server_registry'},{numerator:done,denominator:total,ratio:done/total,missing:req.filter(r=>!ids.has(r.id)).map(r=>r.id),meaning:'input_coverage_not_accuracy'},[],['Danh sách valid_field_ids chỉ là mô phỏng; production phải lấy từ server-side validators.']);}
+export function goalProgress(input){const {actions,window_start,window_end}=input;parseDate(window_start);parseDate(window_end);ensure(window_end>=window_start,'INVALID_WINDOW','Khoảng thời gian đảo ngược.');ensure(Array.isArray(actions)&&actions.length<=500,'INVALID_ACTIONS','Danh sách tối đa 500 hành động.');ensure(new Set(actions.map(a=>a.id)).size===actions.length,'DUPLICATE_ACTION','Mỗi hành động cần ID duy nhất.');for(const a of actions){ensure(a&&typeof a.id==='string'&&a.id.trim().length>0,'INVALID_ACTION_ID','Mỗi hành động cần ID.');parseDate(a.due_on);enumValue(a.state,['scheduled','done','cancelled'],'action.state');}
+ const due=actions.filter(a=>a.state!=='cancelled'&&a.due_on>=window_start&&a.due_on<=window_end);const done=due.filter(a=>a.state==='done').length;
+ return result('LCF-12','2.0',input,{window:'inclusive_due_date',cancelled:'excluded'},{completed:done,due:due.length,ratio:due.length?done/due.length:null,reason:due.length?null:'no_due_actions'},[],['Không phải điểm kỷ luật hoặc giá trị con người; trạng thái done do người dùng tự khai.']);}
+export function cashflow(input){const {currency,entries}=input;ensure(typeof currency==='string'&&/^[A-Z]{3}$/.test(currency),'INVALID_CURRENCY','Mã tiền tệ phải gồm ba chữ cái.');ensure(Array.isArray(entries)&&entries.length<=500,'INVALID_ENTRIES','Tối đa 500 giao dịch mô phỏng.');let ins=0n,outs=0n;for(const e of entries){ensure(e.currency===currency,'MIXED_CURRENCY','Không cộng nhiều tiền tệ khi chưa có chính sách tỷ giá.');enumValue(e.kind,['inflow','outflow'],'kind');ensure(typeof e.minor_units==='string'&&/^(0|[1-9]\d{0,17})$/.test(e.minor_units),'INVALID_MONEY','Đơn vị tiền nhỏ nhất phải là chuỗi số nguyên không âm, tối đa 18 chữ số.');if(e.kind==='inflow')ins+=BigInt(e.minor_units);else outs+=BigInt(e.minor_units);}
+ return result('LCF-13','2.0',input,{money:'integer_minor_units_no_fx'},{currency,inflows_minor:ins.toString(),outflows_minor:outs.toString(),net_minor:(ins-outs).toString()},[],['Dữ liệu tự khai; không phải tư vấn đầu tư, thuế hoặc kế toán đã kiểm toán.']);}
+export function resonanceSummary(input){const {observations}=input;ensure(Array.isArray(observations)&&observations.length<=200,'INVALID_OBSERVATIONS','Tối đa 200 lần quan sát.');const rows=observations.map(o=>{parseDate(o.date);integer(o.rating,0,10,'rating');ensure(typeof o.field==='string'&&o.field.trim().length>0&&o.field.length<=60,'INVALID_FIELD','Thiếu trường quan sát.');return o;});const grouped=new Map();for(const o of rows){if(!grouped.has(o.field))grouped.set(o.field,[]);grouped.get(o.field).push(o.rating);}const summaries=[...grouped.entries()].map(([field,vs])=>{const sorted=[...vs].sort((a,b)=>a-b),n=vs.length;return {field,count:n,sum:vs.reduce((a,b)=>a+b,0),mean:vs.reduce((a,b)=>a+b,0)/n,median:n%2?sorted[(n-1)/2]:(sorted[n/2-1]+sorted[n/2])/2};});return result('LCF-14','2.0',input,{rating:'self_report_0_10',aggregation:'descriptive_only'},{summaries},[],['Không kết luận nguyên nhân chữa lành từ tương quan hoặc điểm cảm nhận.','Không chẩn đoán sức khỏe.']);}
+export function preferenceMatrix(input){const {criteria,options}=input;ensure(Array.isArray(criteria)&&criteria.length>0&&criteria.length<=12&&Array.isArray(options)&&options.length>0&&options.length<=20,'INVALID_MATRIX','Ma trận cần tiêu chí và phương án trong giới hạn.');ensure(new Set(criteria.map(c=>c.id)).size===criteria.length,'DUPLICATE_CRITERION','Mã tiêu chí phải duy nhất.');let weights=0;for(const c of criteria){integer(c.weight,0,100,'weight');weights+=c.weight;}ensure(weights===100,'INVALID_WEIGHTS','Tổng trọng số phải bằng 100.');const ranked=options.map(o=>{let numerator=0,known=0;const missing=[];for(const c of criteria){const v=o.values?.[c.id];if(v===null||v===undefined){missing.push(c.id);continue;}integer(v,0,100,'preference value');numerator+=v*c.weight;known+=c.weight;}return {id:o.id,weighted_points:numerator/100,covered_weight:known,missing,complete:missing.length===0};});ensure(new Set(ranked.map(r=>r.id)).size===ranked.length,'DUPLICATE_OPTION','Mã phương án phải duy nhất.');return result('LCF-15','2.0',input,{scoring:'declared_user_preference_not_destiny'},{options:ranked.every(r=>r.complete)?ranked.sort((a,b)=>b.weighted_points-a.weighted_points):ranked,ranking_allowed:ranked.every(r=>r.complete)},[],['Không chuẩn hóa phần thiếu thành điểm cao hơn; không xếp hạng cuối khi thiếu tiêu chí.']);}
