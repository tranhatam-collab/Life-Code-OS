+import {ensure,integer,enumValue} from './errors.mjs';
+import {result} from './canonical.mjs';
+import {digitSum,reduction,root} from './numbers.mjs';
+const pad=n=>String(n).padStart(2,'0');
+export function leap(y){return y%4===0&&(y%100!==0||y%400===0);}
+export function days(y,m){return [31,leap(y)?29:28,31,30,31,30,31,31,30,31,30,31][m-1];}
+export function parseDate(s){ensure(typeof s==='string'&&/^\d{4}-\d{2}-\d{2}$/.test(s),'INVALID_DATE','Ngày phải là YYYY-MM-DD, không đoán DD/MM hoặc MM/DD.');const [y,m,d]=s.split('-').map(Number);integer(y,1600,2500,'năm');integer(m,1,12,'tháng');integer(d,1,days(y,m),'ngày');return {year:y,month:m,day:d};}
+function dateString(y,m,d){return `${y}-${pad(m)}-${pad(d)}`;}
+export function anniversary(s,year,policy='feb28'){const x=parseDate(s);integer(year,1600,2500,'năm đích');enumValue(policy,['feb28','mar01'],'leap_policy');if(x.month===2&&x.day===29&&!leap(year))return policy==='feb28'?dateString(year,2,28):dateString(year,3,1);return dateString(year,x.month,x.day);}
+export function ageAt(birth,asOf,policy='feb28'){const b=parseDate(birth),a=parseDate(asOf);ensure(asOf>=birth,'FUTURE_BIRTH','Ngày sinh không được sau ngày đối chiếu.');let age=a.year-b.year;if(asOf<anniversary(birth,a.year,policy))age--;return age;}
