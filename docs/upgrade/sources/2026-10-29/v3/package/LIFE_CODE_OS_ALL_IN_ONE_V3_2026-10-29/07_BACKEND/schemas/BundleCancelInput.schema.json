{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v3:BundleCancelInput",
  "type": "object",
  "required": [
    "reason",
    "expected_version"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "expected_version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
