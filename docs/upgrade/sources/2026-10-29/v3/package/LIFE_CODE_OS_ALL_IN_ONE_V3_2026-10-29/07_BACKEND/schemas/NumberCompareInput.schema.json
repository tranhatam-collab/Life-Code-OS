        "required": [
          "id",
          "sequence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sequence": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "context": {
            "enum": [
              "phone_vn",
              "generic_sequence",
              "identifier_suffix4"
            ]
          }
        },
        "additionalProperties": false
