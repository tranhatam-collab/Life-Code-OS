{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v3:KnowledgeTransferInput",
  "type": "object",
  "required": [
    "subject_id",
    "recipient_account_id",
    "purpose",
    "artifact_ids",
    "expires_at",
    "expected_access_revision"
  ],
  "properties": {
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "recipient_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "const": "knowledge_legacy_sharing"
    },
    "artifact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "expected_access_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
