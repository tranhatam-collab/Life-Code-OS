{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v2:RunCompare",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "scope": {
      "enum": [
        "calculation",
        "claims",
        "coverage",
        "full"
      ]
    }
  },
  "required": [
    "run_ids",
    "scope"
  ]
}
