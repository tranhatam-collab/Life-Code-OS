{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v2:RunStatus",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "blocked",
        "review_required",
        "approved",
        "published",
        "failed",
        "cancelled"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "completed_methods": {
      "type": "integer",
      "minimum": 0
    },
    "total_methods": {
      "type": "integer",
      "minimum": 0
    },
    "missing_inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "run_id",
    "state",
    "version",
    "completed_methods",
    "total_methods",
    "missing_inputs",
    "error_code",
    "updated_at"
  ]
}
