{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lifecode:v2:OfflineBatch",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "device_batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "client_event_id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_type": {
            "enum": [
              "journal",
              "action_checkin"
            ]
          },
          "expected_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "payload": {
            "type": "object"
          }
        },
        "required": [
          "client_event_id",
          "resource_type",
          "expected_version",
          "occurred_at",
          "payload"
        ]
      }
    }
  },
  "required": [
    "device_batch_id",
    "operations"
  ]
}
