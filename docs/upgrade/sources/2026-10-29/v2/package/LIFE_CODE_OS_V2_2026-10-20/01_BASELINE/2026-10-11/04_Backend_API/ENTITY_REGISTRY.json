[
  {
    "table": "tenant",
    "scope": "global",
    "columns": [
      "name text NOT NULL",
      "kind text NOT NULL CHECK (kind IN ('personal','organization','partner'))",
      "country_pack_id text",
      "state text NOT NULL DEFAULT 'pending'"
    ],
    "purpose": "Không gian nghiệp vụ, không đồng nghĩa quyền đọc tất cả subject"
  },
  {
    "table": "account",
    "scope": "global",
    "columns": [
      "idp_issuer text",
      "idp_subject text",
      "display_name text",
      "status text NOT NULL DEFAULT 'pending'",
      "UNIQUE (idp_issuer, idp_subject)"
    ],
    "purpose": "Identity binding được server xác minh"
  },
  {
    "table": "tenant_membership",
    "scope": "tenant",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "role_code text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz",
      "UNIQUE (tenant_id, account_id, role_code)"
    ],
    "purpose": "Seat/workspace membership không tự cấp PI grants"
  },
  {
    "table": "auth_session",
    "scope": "global",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "token_digest bytea NOT NULL UNIQUE",
      "expires_at timestamptz NOT NULL",
      "revoked_at timestamptz",
      "last_seen_at timestamptz",
      "device_label text"
    ],
    "purpose": "Không lưu bearer plaintext"
  },
  {
    "table": "processing_purpose",
    "scope": "global",
    "columns": [
      "purpose_code text NOT NULL",
      "version text NOT NULL",
      "description text NOT NULL",
      "lawful_basis_record text",
      "status text NOT NULL DEFAULT 'draft'",
      "UNIQUE(purpose_code,version)"
    ],
    "purpose": "Mục đích/căn cứ được legal phê duyệt"
  },
  {
    "table": "policy_version",
    "scope": "global",
    "columns": [
      "policy_code text NOT NULL",
      "version text NOT NULL",
      "locale text NOT NULL",
      "content_digest text NOT NULL",
      "approved_at timestamptz",
      "UNIQUE(policy_code,version,locale)"
    ],
    "purpose": "Notice/terms/retention có phiên bản"
  },
  {
    "table": "profile_subject",
    "scope": "tenant",
    "columns": [
      "controller_account_id uuid NOT NULL REFERENCES lc.account(id)",
      "display_name text NOT NULL",
      "subject_kind text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'"
    ],
    "purpose": "Người được phân tích khác account"
  },
  {
    "table": "access_grant",
    "scope": "subject",
    "columns": [
      "grantee_account_id uuid NOT NULL REFERENCES lc.account(id)",
      "purpose_id uuid NOT NULL REFERENCES lc.processing_purpose(id)",
      "permissions jsonb NOT NULL",
      "section_scope jsonb NOT NULL DEFAULT '[]'",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz NOT NULL",
      "revoked_at timestamptz"
    ],
    "purpose": "Grant cụ thể, server validate và DB enforce"
  },
  {
    "table": "consent_record",
    "scope": "subject",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "purpose_id uuid NOT NULL REFERENCES lc.processing_purpose(id)",
      "policy_version_id uuid NOT NULL REFERENCES lc.policy_version(id)",
      "decision text NOT NULL CHECK(decision IN ('accept','withdraw'))",
      "scope jsonb NOT NULL",
      "occurred_at timestamptz NOT NULL"
    ],
    "purpose": "Ledger quyết định không overwrite"
  },
  {
    "table": "profile_version",
    "scope": "subject",
    "columns": [
      "version_number integer NOT NULL CHECK(version_number>0)",
      "raw_fields jsonb NOT NULL",
      "normalized_fields jsonb NOT NULL",
      "source_assertions jsonb NOT NULL",
      "supersedes_id uuid",
      "UNIQUE(tenant_id,subject_id,version_number)"
    ],
    "purpose": "Không silent fill, hypothesis giữ riêng"
  },
  {
    "table": "data_hypothesis",
    "scope": "subject",
    "columns": [
      "profile_version_id uuid NOT NULL",
      "label text NOT NULL",
      "proposed_fields jsonb NOT NULL",
      "source_refs jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'unverified'",
      "FOREIGN KEY(tenant_id,subject_id,profile_version_id) REFERENCES lc.profile_version(tenant_id,subject_id,id)"
    ],
    "purpose": "Ngày/năm/giờ khác nhau giữ thành phương án"
  },
  {
    "table": "source_record",
    "scope": "global",
    "columns": [
      "source_code text NOT NULL UNIQUE",
      "title text NOT NULL",
      "canonical_url text",
      "language_code text",
      "access_state text NOT NULL DEFAULT 'not_read'"
    ],
    "purpose": "Nguồn công khai/phương pháp; không lưu PI khách"
  },
  {
    "table": "source_edition",
    "scope": "global",
    "columns": [
      "source_id uuid NOT NULL REFERENCES lc.source_record(id)",
      "edition_label text NOT NULL",
      "content_digest text",
      "rights_state text NOT NULL DEFAULT 'pending'"
    ],
    "purpose": "Đúng lần in/trang/translation"
  },
  {
    "table": "rights_record",
    "scope": "global",
    "columns": [
      "source_edition_id uuid NOT NULL REFERENCES lc.source_edition(id)",
      "rights_scope jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz",
      "legal_reference text"
    ],
    "purpose": "Không mặc định ingest/train/distribute"
  },
  {
    "table": "method",
    "scope": "global",
    "columns": [
      "method_code text NOT NULL UNIQUE",
      "family_code text NOT NULL",
      "name text NOT NULL"
    ],
    "purpose": "Danh mục K01–K20"
  },
  {
    "table": "method_release",
    "scope": "global",
    "columns": [
      "method_id uuid NOT NULL REFERENCES lc.method(id)",
      "version text NOT NULL",
      "configuration jsonb NOT NULL",
      "source_refs jsonb NOT NULL",
      "limitations jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'draft'",
      "approved_by uuid REFERENCES lc.account(id)",
      "UNIQUE(method_id,version)"
    ],
    "purpose": "Release không edit inplace"
  },
  {
    "table": "product_release",
    "scope": "global",
    "columns": [
      "product_code text NOT NULL",
      "version text NOT NULL",
      "requirements jsonb NOT NULL",
      "method_release_refs jsonb NOT NULL",
      "quota_policy jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'draft'",
      "UNIQUE(product_code,version)"
    ],
    "purpose": "Catalog/eligibility requirements server-defined"
  },
  {
    "table": "observation",
    "scope": "subject",
    "columns": [
      "purpose_id uuid NOT NULL REFERENCES lc.processing_purpose(id)",
      "kind text NOT NULL",
      "occurred_at timestamptz NOT NULL",
      "payload jsonb NOT NULL",
      "source_kind text NOT NULL",
      "instrument_release_ref text"
    ],
    "purpose": "Nhật ký/self-report không trở thành fact tự động"
  },
  {
    "table": "analysis_run",
    "scope": "subject",
    "columns": [
      "profile_version_id uuid NOT NULL",
      "product_release_id uuid NOT NULL REFERENCES lc.product_release(id)",
      "purpose_id uuid NOT NULL REFERENCES lc.processing_purpose(id)",
      "requested_by uuid NOT NULL REFERENCES lc.account(id)",
      "state text NOT NULL DEFAULT 'queued'",
      "configuration_digest text NOT NULL",
      "FOREIGN KEY(tenant_id,subject_id,profile_version_id) REFERENCES lc.profile_version(tenant_id,subject_id,id)"
    ],
    "purpose": "Chốt profile/method config và quyền"
  },
  {
    "table": "method_result",
    "scope": "subject",
    "columns": [
      "analysis_run_id uuid NOT NULL",
      "method_release_id uuid NOT NULL REFERENCES lc.method_release(id)",
      "result jsonb NOT NULL",
      "state text NOT NULL",
      "FOREIGN KEY(tenant_id,subject_id,analysis_run_id) REFERENCES lc.analysis_run(tenant_id,subject_id,id)"
    ],
    "purpose": "Typed results nullable score; schema validated service+constraints"
  },
  {
    "table": "claim",
    "scope": "subject",
    "columns": [
      "method_result_id uuid",
      "claim_type text NOT NULL CHECK(claim_type IN ('fact','self_report','observation','symbolic_interpretation','derived_metric','model_probability'))",
      "text_vi text NOT NULL",
      "source_refs jsonb NOT NULL",
      "probability numeric",
      "model_release_ref text",
      "state text NOT NULL DEFAULT 'draft'",
      "CHECK ((claim_type='model_probability' AND probability BETWEEN 0 AND 1 AND model_release_ref IS NOT NULL) OR (claim_type<>'model_probability' AND probability IS NULL AND model_release_ref IS NULL))",
      "FOREIGN KEY(tenant_id,subject_id,method_result_id) REFERENCES lc.method_result(tenant_id,subject_id,id)"
    ],
    "purpose": "Nhận định có lineage, không probability tượng trưng"
  },
  {
    "table": "claim_dependency",
    "scope": "subject",
    "columns": [
      "claim_id uuid NOT NULL",
      "depends_on_claim_id uuid NOT NULL",
      "FOREIGN KEY(tenant_id,subject_id,claim_id) REFERENCES lc.claim(tenant_id,subject_id,id)",
      "FOREIGN KEY(tenant_id,subject_id,depends_on_claim_id) REFERENCES lc.claim(tenant_id,subject_id,id)"
    ],
    "purpose": "DAG lineage; cycle check tại service/test"
  },
  {
    "table": "report_snapshot",
    "scope": "subject",
    "columns": [
      "product_release_id uuid NOT NULL REFERENCES lc.product_release(id)",
      "content_revision text NOT NULL",
      "content_tree jsonb NOT NULL",
      "source_snapshot jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'draft'",
      "reviewer_account_id uuid REFERENCES lc.account(id)",
      "digest text NOT NULL"
    ],
    "purpose": "Approved snapshots không tự sửa; vẫn chịu deletion"
  },
  {
    "table": "report_artifact",
    "scope": "subject",
    "columns": [
      "report_snapshot_id uuid NOT NULL",
      "format text NOT NULL CHECK(format IN ('pdf','docx','html','markdown'))",
      "private_object_key text NOT NULL",
      "sha256 text NOT NULL",
      "expires_at timestamptz",
      "FOREIGN KEY(tenant_id,subject_id,report_snapshot_id) REFERENCES lc.report_snapshot(tenant_id,subject_id,id)"
    ],
    "purpose": "Chỉ qua authorized proxy/short URL"
  },
  {
    "table": "action_plan",
    "scope": "subject",
    "columns": [
      "title text NOT NULL",
      "goal text NOT NULL",
      "success_measure jsonb NOT NULL",
      "horizon_days integer NOT NULL CHECK(horizon_days>0)",
      "state text NOT NULL DEFAULT 'draft'"
    ],
    "purpose": "Quyền lựa chọn người dùng"
  },
  {
    "table": "action_item",
    "scope": "subject",
    "columns": [
      "action_plan_id uuid NOT NULL",
      "description text NOT NULL",
      "due_at timestamptz",
      "state text NOT NULL DEFAULT 'open'",
      "FOREIGN KEY(tenant_id,subject_id,action_plan_id) REFERENCES lc.action_plan(tenant_id,subject_id,id)"
    ],
    "purpose": "Action không tự hoàn thành vì AI viết"
  },
  {
    "table": "action_outcome",
    "scope": "subject",
    "columns": [
      "action_item_id uuid NOT NULL",
      "observed_at timestamptz NOT NULL",
      "state text NOT NULL",
      "note text",
      "FOREIGN KEY(tenant_id,subject_id,action_item_id) REFERENCES lc.action_item(tenant_id,subject_id,id)"
    ],
    "purpose": "Check-in và review"
  },
  {
    "table": "commerce_order",
    "scope": "tenant",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "product_release_id uuid NOT NULL REFERENCES lc.product_release(id)",
      "amount_minor bigint NOT NULL CHECK(amount_minor>=0)",
      "currency text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "quote_version text NOT NULL"
    ],
    "purpose": "Money integer minor units; no JSfloat authority"
  },
  {
    "table": "payment_event",
    "scope": "tenant",
    "columns": [
      "commerce_order_id uuid",
      "provider_code text NOT NULL",
      "provider_event_id text NOT NULL",
      "payload_digest text NOT NULL",
      "signature_verified boolean NOT NULL DEFAULT false",
      "state text NOT NULL DEFAULT 'received'",
      "UNIQUE(provider_code,provider_event_id)",
      "FOREIGN KEY(tenant_id,commerce_order_id) REFERENCES lc.commerce_order(tenant_id,id)"
    ],
    "purpose": "Verify signature before businessprocessing; state ordering"
  },
  {
    "table": "entitlement",
    "scope": "tenant",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "product_release_id uuid NOT NULL REFERENCES lc.product_release(id)",
      "commerce_order_id uuid",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz",
      "FOREIGN KEY(tenant_id,commerce_order_id) REFERENCES lc.commerce_order(tenant_id,id)"
    ],
    "purpose": "Không phải access_grant"
  },
  {
    "table": "practitioner_case",
    "scope": "subject",
    "columns": [
      "practitioner_account_id uuid NOT NULL REFERENCES lc.account(id)",
      "purpose_id uuid NOT NULL REFERENCES lc.processing_purpose(id)",
      "scope jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'pending'"
    ],
    "purpose": "Assignment không tự cho mọi nội dung"
  },
  {
    "table": "academy_enrollment",
    "scope": "tenant",
    "columns": [
      "account_id uuid NOT NULL REFERENCES lc.account(id)",
      "course_release_ref text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'"
    ],
    "purpose": "Học liệu version, không chứng chỉ lâm sàng"
  },
  {
    "table": "certificate",
    "scope": "tenant",
    "columns": [
      "enrollment_id uuid NOT NULL",
      "public_verification_id text NOT NULL UNIQUE",
      "scope jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz",
      "FOREIGN KEY(tenant_id,enrollment_id) REFERENCES lc.academy_enrollment(tenant_id,id)"
    ],
    "purpose": "Public view tối thiểu, revoke/expiry"
  },
  {
    "table": "country_pack",
    "scope": "global",
    "columns": [
      "country_code text NOT NULL",
      "version text NOT NULL",
      "policy jsonb NOT NULL",
      "legal_review_ref text",
      "state text NOT NULL DEFAULT 'draft'",
      "UNIQUE(country_code,version)"
    ],
    "purpose": "Locale không đồng nghĩa legal permission"
  },
  {
    "table": "partner_license",
    "scope": "tenant",
    "columns": [
      "country_pack_id uuid NOT NULL REFERENCES lc.country_pack(id)",
      "allowed_capabilities jsonb NOT NULL",
      "agreement_reference text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "expires_at timestamptz"
    ],
    "purpose": "License/franchise legal classification riêng"
  },
  {
    "table": "outbox_event",
    "scope": "tenant",
    "columns": [
      "aggregate_type text NOT NULL",
      "aggregate_id uuid NOT NULL",
      "event_type text NOT NULL",
      "payload_reference text NOT NULL",
      "state text NOT NULL DEFAULT 'pending'",
      "published_at timestamptz"
    ],
    "purpose": "Atomic with business transaction"
  },
  {
    "table": "job_receipt",
    "scope": "tenant",
    "columns": [
      "namespace text NOT NULL",
      "idempotency_key text NOT NULL",
      "request_digest text NOT NULL",
      "result_reference text",
      "state text NOT NULL DEFAULT 'pending'",
      "UNIQUE(tenant_id,namespace,idempotency_key)"
    ],
    "purpose": "Durable dedup; compare digest; no memoryledger production"
  },
  {
    "table": "audit_event",
    "scope": "tenant",
    "columns": [
      "actor_account_id uuid REFERENCES lc.account(id)",
      "action_code text NOT NULL",
      "resource_type text NOT NULL",
      "resource_id uuid",
      "minimal_metadata jsonb NOT NULL",
      "occurred_at timestamptz NOT NULL"
    ],
    "purpose": "No raw PII or tokens; policy retention"
  },
  {
    "table": "deletion_job",
    "scope": "subject",
    "columns": [
      "requestor_account_id uuid NOT NULL REFERENCES lc.account(id)",
      "scope jsonb NOT NULL",
      "state text NOT NULL DEFAULT 'requested'",
      "receipt jsonb",
      "completed_at timestamptz"
    ],
    "purpose": "Track all stores and backup tombstone"
  },
  {
    "table": "legal_hold",
    "scope": "subject",
    "columns": [
      "reason_reference text NOT NULL",
      "approved_by uuid NOT NULL REFERENCES lc.account(id)",
      "expires_at timestamptz NOT NULL",
      "state text NOT NULL DEFAULT 'active'"
    ],
    "purpose": "Có giới hạn và legal review, không vô thời hạn"
  },
  {
    "table": "revocation_tombstone",
    "scope": "tenant",
    "columns": [
      "resource_digest text NOT NULL",
      "reason_code text NOT NULL",
      "effective_at timestamptz NOT NULL",
      "expires_at timestamptz"
    ],
    "purpose": "Không PI raw; replay trước restoreopening"
  }
]
