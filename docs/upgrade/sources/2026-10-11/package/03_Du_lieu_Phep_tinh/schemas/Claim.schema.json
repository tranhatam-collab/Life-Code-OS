{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/Claim.json",
  "title": "Claim",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "enum": [
        "fact",
        "self_report",
        "observation",
        "symbolic_interpretation",
        "derived_metric",
        "model_probability"
      ]
    },
    "text_vi": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "observation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "probability": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "model_release_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_state": {
      "enum": [
        "draft",
        "needs_review",
        "approved",
        "rejected",
        "withdrawn"
      ]
    }
  },
  "required": [
    "claim_id",
    "subject_id",
    "type",
    "text_vi",
    "source_ids",
    "scope",
    "probability",
    "model_release_id",
    "limitations",
    "review_state"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "model_probability"
          }
        }
      },
      "then": {
        "properties": {
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "model_release_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "probability",
          "model_release_id"
        ]
      },
      "else": {
        "properties": {
          "probability": {
            "type": "null"
          },
          "model_release_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
