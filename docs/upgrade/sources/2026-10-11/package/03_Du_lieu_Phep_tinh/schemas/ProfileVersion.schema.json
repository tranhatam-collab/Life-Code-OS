{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/ProfileVersion.json",
  "title": "ProfileVersion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "const": "2.0-proposed"
    },
    "full_name_original": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "full_name_nfc": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "birth": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.lifecode.iai.one/proposed/Birth.json",
      "title": "Birth",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calendar": {
          "enum": [
            "gregorian",
            "julian",
            "lunisolar",
            "unknown"
          ]
        },
        "date_original": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_iso": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "time_local": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "time_precision": {
          "enum": [
            "exact_reported",
            "approximate",
            "range",
            "unknown"
          ]
        },
        "place_original": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tzdb_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_kind": {
          "enum": [
            "self_report",
            "document_confirmed",
            "hypothesis"
          ]
        },
        "hypothesis_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "required": [
        "calendar",
        "date_original",
        "date_iso",
        "time_local",
        "time_precision",
        "place_original",
        "timezone_id",
        "tzdb_version",
        "source_kind",
        "hypothesis_ids"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "record_origin": {
      "enum": [
        "user_entry",
        "authorized_import",
        "legacy_quarantine"
      ]
    }
  },
  "required": [
    "profile_version_id",
    "subject_id",
    "tenant_id",
    "schema_version",
    "full_name_original",
    "full_name_nfc",
    "birth",
    "created_at",
    "supersedes",
    "record_origin"
  ]
}
