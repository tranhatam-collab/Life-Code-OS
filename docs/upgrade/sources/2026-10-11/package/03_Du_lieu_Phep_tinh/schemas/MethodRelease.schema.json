{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/MethodRelease.json",
  "title": "MethodRelease",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "method_id": {
      "type": "string"
    },
    "release_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "pattern": "^K(0[1-9]|1[0-9]|20)$"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "researching",
        "specified",
        "calculation_verified",
        "content_reviewed",
        "permitted_for_product",
        "deprecated",
        "retired"
      ]
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edition_locations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rights_status": {
      "enum": [
        "pending",
        "permitted",
        "restricted",
        "expired"
      ]
    },
    "input_schema_ref": {
      "type": "string"
    },
    "output_schema_ref": {
      "type": "string"
    },
    "rule_spec_ref": {
      "type": "string"
    },
    "configuration": {
      "type": "object"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "golden_cases_ref": {
      "type": "string"
    },
    "test_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_claim_types": {
      "type": "array",
      "items": {
        "enum": [
          "fact",
          "self_report",
          "observation",
          "symbolic_interpretation",
          "derived_metric",
          "model_probability"
        ]
      }
    },
    "allowed_product_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_country_packs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "method_id",
    "release_id",
    "family_id",
    "version",
    "status",
    "source_ids",
    "edition_locations",
    "rights_status",
    "input_schema_ref",
    "output_schema_ref",
    "rule_spec_ref",
    "configuration",
    "limitations",
    "golden_cases_ref",
    "test_receipt_ref",
    "allowed_claim_types",
    "allowed_product_ids",
    "allowed_country_packs",
    "approved_by",
    "approved_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "permitted_for_product"
          }
        }
      },
      "then": {
        "properties": {
          "rights_status": {
            "const": "permitted"
          },
          "source_ids": {
            "type": "array",
            "minItems": 1
          },
          "test_receipt_ref": {
            "type": "string",
            "minLength": 1
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ]
}
