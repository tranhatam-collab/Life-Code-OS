{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lifecode.iai.one/proposed/JobEnvelope.json",
  "title": "JobEnvelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_id": {
      "type": "string",
      "format": "uuid"
    },
    "principal_account_id": {
      "type": "string",
      "format": "uuid"
    },
    "purpose_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "operation": {
      "enum": [
        "analyze",
        "draft_report",
        "export_report",
        "privacy_export",
        "delete_subject",
        "send_optin_reminder"
      ]
    },
    "resource_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization_recheck_required": {
      "const": true
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "payload_ref": {
      "type": "string"
    },
    "raw_personal_data_in_queue": {
      "const": false
    }
  },
  "required": [
    "job_id",
    "tenant_id",
    "subject_id",
    "principal_account_id",
    "purpose_id",
    "policy_version",
    "operation",
    "resource_id",
    "idempotency_key",
    "request_digest",
    "created_at",
    "authorization_recheck_required",
    "attempt",
    "payload_ref",
    "raw_personal_data_in_queue"
  ]
}
