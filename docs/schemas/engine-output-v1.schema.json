{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecode.iai.one/schemas/engine-output-v1.json",
  "title": "LifeCodeEngineOutputV1",
  "description": "Khớp README §17 — không được phá contract này.",
  "type": "object",
  "required": ["confidence", "signals", "insights", "recommendations"],
  "properties": {
    "score": {
      "description": "Điểm layer (nullable khi thiếu dữ liệu)",
      "type": ["number", "null"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "signals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "insights": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommendations": {
      "type": "object",
      "required": ["stop", "start", "protect", "build"],
      "properties": {
        "stop": { "type": "array", "items": { "type": "string" } },
        "start": { "type": "array", "items": { "type": "string" } },
        "protect": { "type": "array", "items": { "type": "string" } },
        "build": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "data_gaps": {
      "description": "Tùy chọn — layer/field thiếu dữ liệu",
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
